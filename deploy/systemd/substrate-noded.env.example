# Copy to /etc/substrate/noded.env, chmod 0600, chown root:root.
# These are secrets: they are deliberately NOT in the YAML config, so the config
# can be readable and version-controlled while these are not.

# Signs sandbox-scoped JWTs. An empty value makes tokens forgeable, and the
# minting primitive fails closed rather than issuing one.
SUBSTRATE_JWT_SECRET=

# Gates /v1/admin/* (creating orgs, projects and API keys).
# EMPTY DISABLES THE ADMIN API ENTIRELY -- that is the safe default. Set it only
# on the node you provision from, and rotate by changing it here and restarting:
# it is not stored in the database, so a database compromise cannot mint tenants.
# Generate with:  printf 'ak_%s\n' "$(openssl rand -hex 24)"
SUBSTRATE_ADMIN_KEY=

# The first tenant key created at bootstrap.
SUBSTRATE_API_KEY=
